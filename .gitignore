# Auto-generated secrets (setup-graph.sh) — NEVER commit
# (secrets.env.example IS committed as a template.)
infra/common/secrets.env
consent.err

# Per-phase generated state (endpoints, keys, image refs) — regenerated per build
infra/**/outputs.env
infra/phase10-vmhost/toolapi-outputs.env
infra/common/prebuilt_images.env
tools/.toolapi.env.rendered

# Node / build artifacts
node_modules/
videoassist/node_modules/
videoassist/dist/

# Python
__pycache__/
*.pyc
.venv/

# Packaging / logs
*.tar.gz
*.sha256
*.log

# --- Data-gen VM (phase10) — never commit the SSH private key; keep rendered cloud-init out ---
# The keypair normally lives in $HOME/.ssh (outside the repo); these patterns are belt-and-braces
# in case VM_SSH_KEY_DIR is ever pointed inside the tree.
**/rmx_vm_host
**/rmx_vm_host.pub
.ssh/rmx_vm_host*
infra/phase10-vmhost/.cloud-init.rendered.yaml
# Rendered Caddyfile / systemd units / EnvironmentFile. The TEMPLATES are committed; the
# rendered output is not — it is host-specific and .rmx.env.rendered briefly holds SECRETS.
infra/phase10-vmhost/.Caddyfile.rendered
infra/phase10-vmhost/.rmx-*.service.rendered
infra/phase10-vmhost/.rmx.env.rendered

# --- Reusable TLS cert (infra/cert/) IS tracked on purpose ----------------------------------
# The Caddy cert store is committed ENCRYPTED (see tools/cert_store.sh + infra/cert/README.md)
# so every build reuses it with no ACME call. Three artifacts must be tracked: the ciphertext,
# the AES key committed beside it, and the lock file. Force-keep them against broader rules.
!infra/cert/
!infra/cert/caddy-data.tgz.enc
!infra/cert/cert-enc.key
!infra/cert/.cert-lock.json
# The PLAINTEXT tarball must NEVER be committed — it contains the TLS private key in the
# clear. up.sh only ever writes it as a transient temp file and shreds it, but this rule is
# what guarantees a stray one cannot be added even with `git add -A`.
infra/cert/caddy-data.tgz
infra/phase10-vmhost/.caddy-data.tgz

# OS junk
.DS_Store
