# =====================================================================================
# infra/phase10-vmhost/rmx-videoassist.service.tmpl
#
# Rendered to /etc/systemd/system/rmx-videoassist.service by infra/phase10-vmhost/up.sh
# (sed token substitution). Runs the ACS Video Assist app (Node/Express + the built Vite
# SPA) natively as the unprivileged service account — no container, no ACR.
#
# BINDS 127.0.0.1 ONLY, via the HOST env var that server.js passes to app.listen().
# Caddy is the sole public ingress. Binding is explicit rather than relying on the NSG.
#
# Tokens (each is the NAME below wrapped in double underscores, written that way here so
# this comment still reads correctly in the RENDERED unit file):
#   APP_USER            unprivileged service account
#   VIDEOASSIST_DIR     /opt/rmx/videoassist (server.js, node_modules, dist/ live here)
#   VIDEOASSIST_HOST    127.0.0.1
#   VIDEOASSIST_PORT    3000
#   NODE_BIN            absolute path to node (NodeSource install: /usr/bin/node)
#   ENV_FILE            root-owned 0600 EnvironmentFile holding the SHARED secrets
#   APP_ENV_FILE        root-owned 0600 EnvironmentFile holding this app's own config
#
# Two EnvironmentFiles, deliberately: the shared one carries secrets used by more than one
# service (and the managed-identity pin), the app one carries per-app config written by that
# app's deploy phase. Later files win, so an app may override a shared default.
# =====================================================================================
[Unit]
Description=Contoso RM Assist Video Assist (ACS live call, Node/Express)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__VIDEOASSIST_DIR__
Environment=NODE_ENV=production
Environment=HOST=__VIDEOASSIST_HOST__
Environment=PORT=__VIDEOASSIST_PORT__
# `-` prefix: start even if the file is absent, so a secretless smoke deploy still boots.
EnvironmentFile=-__ENV_FILE__
EnvironmentFile=-__APP_ENV_FILE__
ExecStart=__NODE_BIN__ __VIDEOASSIST_DIR__/server.js
Restart=always
RestartSec=3

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
