# =====================================================================================
# infra/phase10-vmhost/Caddyfile.tmpl
#
# Rendered to /etc/caddy/Caddyfile by infra/phase10-vmhost/up.sh (sed token substitution).
# Caddy is the SOLE public ingress: it terminates TLS on :443 and reverse-proxies to
# application processes that bind 127.0.0.1 only. Nothing else on the VM is reachable from
# the internet (the NSG opens TCP 22/80/443 and nothing more).
#
# Tokens substituted at deploy time (each is the NAME below wrapped in double underscores,
# written that way here so this comment still reads correctly in the RENDERED file):
#   RMASSIST_HOST      stable host, e.g. rmassist.4.5.6.7.nip.io
#   LETSENCRYPT_EMAIL  ACME registration email
#   ACME_CA            ACME directory URL (production or staging)
#   TOOLAPI_BIND       e.g. 127.0.0.1:8000   (uvicorn / FastAPI, rmx-toolapi.service)
#   VIDEOASSIST_BIND   e.g. 127.0.0.1:3000   (node server.js, rmx-videoassist.service)
#
# ROUTING — one hostname, path prefixes, so ONE cert and ONE ACME order cover everything:
#   /             -> file_server over /opt/rmx/web   (CRM cockpit, pure static)
#   /api/*        -> __TOOLAPI_BIND__                (prefix STRIPPED)
#   /video/*      -> __VIDEOASSIST_BIND__            (prefix STRIPPED)
#
# WHY `handle @name` + `uri strip_prefix` RATHER THAN `handle_path`:
# `handle_path X` is by definition `handle X` + `uri strip_prefix X`, so the stripping
# behaviour here is identical. The explicit form is used because the SSE route below MUST
# be a separate block, and a named matcher (`@sse`) can only be DEFINED at site-block level
# — Caddy rejects `@name` definitions inside `route`/`handle` blocks with a syntax error.
# Since /video therefore needs a site-level matcher anyway, every branch uses the same
# directive type: all four are `handle` blocks, so "first match wins, in source order" is
# unambiguous and does not depend on how Caddy co-orders `handle` against `handle_path`.
#
# Each app keeps serving from its OWN root after stripping (/healthz, /token, /session/start
# …), so no internal route rewrites are needed in either application.
#
# NOTE: Caddy does not probe upstream liveness at startup, so this config loads cleanly
# before rmx-toolapi/rmx-videoassist exist. That is required: up.sh installs this file and
# starts Caddy FIRST to pre-seed (or mint) the certificate, and only later phases deploy the
# app services. Until then /api and /video return 502 while / and ACME work normally.
# =====================================================================================
{
	email __LETSENCRYPT_EMAIL__
	acme_ca __ACME_CA__
	admin off

	# --- HTTP/1.1 and HTTP/2 only; NO HTTP/3 -----------------------------------------
	# Caddy enables HTTP/3 by default and advertises it via `Alt-Svc: h3=":443"`, which a
	# browser caches and then prefers on later visits. HTTP/3 is QUIC over **UDP** 443, but
	# this deployment's NSG opens **TCP** 443 only (see main.bicep securityRules), and
	# corporate networks frequently block outbound UDP 443 too. Dropped UDP produces no
	# rejection, so the browser just waits and the viewer sees ERR_CONNECTION_TIMED_OUT on a
	# site that is answering perfectly over TCP — a failure `curl` never reproduces, because
	# curl does not speak HTTP/3. Removing the advertisement is the fix.
	servers {
		protocols h1 h2
	}
}

__RMASSIST_HOST__ {
	# --- Matchers (site-block level: Caddy does not allow @name inside handle/route) ---
	@sse path /video/insights/stream*
	@video path /video/*
	@api path /api/*
	# A bare /video or /api does NOT match /video/* or /api/*. Without these redirects such a
	# request would fall through to the static file_server, find no file of that name in the
	# webroot, and return a bare 404 — which reads as "the app is not deployed" rather than
	# "you are missing a trailing slash".
	@videoRoot path /video
	@apiRoot path /api
	# Webroot health endpoint, kept for parity with the nginx config this replaced.
	@healthz path /healthz

	# --- Bare-prefix redirects -------------------------------------------------------
	# `redir` runs BEFORE the handle group in Caddy's directive order, and taking a NAMED
	# matcher makes the argument parse unambiguous. That matters: the obvious-looking
	# `handle @videoRoot { redir /video/ 308 }` is a TRAP — in the matcher position Caddy
	# reads a leading-slash token as an INLINE PATH MATCHER, so it parses as
	# matcher=/video/, destination=308, and emits `Location: 308` with status 302.
	# That mis-parse was observed in Caddy's own adapted JSON config; the named-matcher
	# form below adapts to the intended static_response status_code 308, Location /video/.
	redir @videoRoot /video/ 308
	redir @apiRoot /api/ 308

	# --- Server-Sent Events: live nudges pushed to the CRM cockpit --------------------
	# MUST come first. The cockpit holds /video/insights/stream open for the duration of the
	# call. Compression and proxy response buffering would hold events back, so this branch
	# gets NO `encode` and `flush_interval -1` to disable buffering — each nudge reaches the
	# browser the instant nudge-engine emits it, which is the whole point of the demo.
	handle @sse {
		uri strip_prefix /video
		reverse_proxy __VIDEOASSIST_BIND__ {
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}

	# --- Tool API (FastAPI/uvicorn) ---------------------------------------------------
	# Strips "/api", so the app sees /healthz, /crm/propose, ... exactly as it does today.
	handle @api {
		uri strip_prefix /api
		encode zstd gzip
		reverse_proxy __TOOLAPI_BIND__ {
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {remote_host}
		}
	}

	# --- Video Assist (Node/Express + built Vite SPA) ---------------------------------
	# Strips "/video", so Express still resolves /token, /speech/token, /session/start,
	# /bank, /schedule and its SPA fallback from its own root. `reverse_proxy` transparently
	# upgrades WebSockets, which the ACS calling SDK needs.
	handle @video {
		uri strip_prefix /video
		encode zstd gzip
		reverse_proxy __VIDEOASSIST_BIND__ {
			header_up X-Forwarded-Proto https
			header_up X-Real-IP {remote_host}
		}
	}

	# nginx served a JSON /healthz for the Container App's liveness/readiness probes.
	# There is no app to probe now (these are static files), but keeping the endpoint means
	# any existing check or bookmark still answers. It MUST be a `handle` placed before the
	# catch-all: the catch-all `handle` is terminal and sorts ahead of a bare `respond` in
	# Caddy's directive order, so a top-level `respond /healthz` would never be reached.
	# NOTE this is the WEBROOT's /healthz — the Tool API's own is /api/healthz.
	handle @healthz {
		header Content-Type application/json
		respond `{"ok":true,"service":"contoso-rmx-cockpit","served_by":"caddy"}` 200
	}

	# --- CRM cockpit (static files, served straight off disk — no nginx needed) -------
	# NOTE: there is deliberately NO `try_files ... /index.html` SPA fallback here.
	# Two separate static apps share this webroot (the RM Assist cockpit at / and the
	# Core Banking console at /console/), and a root-level SPA fallback would make ANY
	# unknown path under EITHER app silently return the OTHER app's index.html — a 200
	# with the wrong application in it, which is far harder to diagnose than a 404.
	# It is also unnecessary: neither app uses HTML5 history routing. The only history
	# call in the codebase is corebank-console/assets/app.js:112
	# `history.replaceState(null, "", "#" + ...)`, which is a HASH fragment and never
	# reaches the server. The cockpit is deep-linked as `/?event=...` (videoassist/
	# teams.js:20) — the root path plus a QUERY STRING, which file_server already serves.
	# file_server also serves index.html for directory requests and redirects
	# /console -> /console/ on its own, so nothing is lost.
	handle {
		encode zstd gzip
		root * /opt/rmx/web
		file_server
	}

	# Parity with the nginx config this replaced (frontend-crm/nginx/default.conf):
	# the cockpit's mutable assets must never be cached, or a redeployed cockpit keeps
	# serving stale JS from the browser cache in the middle of a demo. `header` sorts
	# BEFORE `handle` and is non-terminal, so this applies to the responses below.
	@nostore path / /index.html /app.js /ui.js /ui.css /refresh.css
	header @nostore Cache-Control "no-store"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		# Nothing is framed today: the cockpit opens the call, the booking page and the
		# customer mobile page with window.open(..., '_blank') — new tabs, not iframes —
		# so DENY would also work right now. SAMEORIGIN is chosen because all three apps
		# are now a single origin, which leaves room for a same-origin embed later without
		# weakening protection against framing by any OTHER origin.
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format console
	}
}
