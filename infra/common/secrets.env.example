# =============================================================================
# secrets.env.example  —  template for infra/common/secrets.env (GIT-IGNORED)
# =============================================================================
# Copy this file to `secrets.env` in the same folder and fill in the values you
# need. `infra/common/env.sh` sources secrets.env automatically if it exists, so
# anything set here overrides the (empty) defaults without editing tracked files.
#
#   cp infra/common/secrets.env.example infra/common/secrets.env
#   # then edit infra/common/secrets.env
#
# NEVER commit secrets.env — it is listed in .gitignore. In GitHub Actions these
# same values are supplied as encrypted repository secrets and written to
# secrets.env by .github/workflows/deploy.yml at run time.
# -----------------------------------------------------------------------------

# --- Microsoft Graph app-only (calendared Teams meetings) --------------------
# Produced automatically by `bash setup-graph.sh` (see docs/ENTRA_PIM_ADMIN.md).
# With these set, every "Video call your RM" tap creates a REAL Teams meeting +
# a calendar event on the RM's Outlook/Teams calendar.
export GRAPH_TENANT_ID=""
export GRAPH_CLIENT_ID=""
export GRAPH_CLIENT_SECRET=""
export RM_USER_ID=""                 # the RM mailbox object id
export MEETING_TIMEZONE="India Standard Time"
export MEETING_DURATION_MINUTES="30"

# --- Teams nudges (Power Automate "Teams webhook" trigger) -------------------
# Signed Power Automate URL that posts synopsis/nudge cards into the RM's Teams.
# See docs/POWER_AUTOMATE.md. Leave empty to run the demo without Teams posting.
export TEAMS_WEBHOOK_URL=""
export TEAMS_NUDGE_WEBHOOK_URL=""    # optional dedicated nudge flow

# --- Optional meeting-link fallbacks (only if you do NOT use Graph) ----------
export RM_MEETING_URL=""             # a standing Teams meeting link for the RM
export SCHEDULE_WEBHOOK_URL=""       # RM-owned Power Automate scheduling flow
export SCHEDULE_AVAILABILITY_WEBHOOK_URL=""
