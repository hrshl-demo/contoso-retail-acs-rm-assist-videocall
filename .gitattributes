# Enforce LF line endings so shell scripts run on Linux regardless of the
# platform they were edited on. Without this, a Windows checkout can reintroduce
# CRLF and break `set -eo pipefail` etc.
* text=auto eol=lf

*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.bicep     text eol=lf
*.json      text eol=lf
*.env       text eol=lf
*.csv       text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binary assets must never be line-ending converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.gz    binary
*.zip   binary
